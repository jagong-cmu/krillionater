{
  "manifest_version": 3,
  "name": "Krillionater",
  "version": "0.1.0",
  "description": "Suggests rare answers for krillion.io and tracks used answers in Puffer Party.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
